# =====================================================================
# Smart Internship Management System (SIMS) - Backend Configuration
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env:
#    cp .env.example .env
# 2. Never commit .env to version control (.gitignore excludes it).
# 3. For production, supply secrets via your cloud platform's environment
#    variables (e.g., Render, Railway, AWS ECS, Heroku).
# =====================================================================

# Server Execution Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Backend HTTP / WebSocket listening port
PORT=5001

# MongoDB Connection String
# - For Local Development:
#   MONGO_URI=mongodb://127.0.0.1:27017/smart_internship_db
# - For Production (MongoDB Atlas Replica Set):
#   MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-subdomain>.mongodb.net/<database_name>?retryWrites=true&w=majority
#   (Replace placeholders with your Atlas database user credentials)
MONGO_URI=mongodb://127.0.0.1:27017/smart_internship_db
# Custom DNS servers to resolve MongoDB Atlas SRV records when ISP/router DNS fails
DNS_SERVERS=8.8.8.8,1.1.1.1

# Allowed Frontend Origin(s) for CORS & Socket.IO Handshake
# - In Development: http://localhost:5173
# - In Production: Set to your actual hosted frontend domain, e.g., https://sims.yourcollege.edu
CLIENT_URL=http://localhost:5173

# Optional additional comma-separated origins (e.g., staging, custom domains)
# ALLOWED_ORIGINS=https://sims.yourcollege.edu,https://admin.yourcollege.edu
ALLOWED_ORIGINS=

# JSON Web Token Secret (Mandatory in production; must be at least 32 characters)
# Generate a cryptographically secure key:
#   $ openssl rand -hex 32
JWT_SECRET=development_jwt_secret_change_in_production_min_32_characters

# JWT Expiration Period (e.g., 500s, 5m, 1d, 7d, 24h)
JWT_EXPIRES_IN=500s

# Google Gemini API Key for Deep AI Resume Analysis & Skill Matching
# - Optional: If left blank or unset, SIMS transparently uses its built-in
#   deterministic semantic matching engine (offline-safe, zero external calls).
# - To enable Gemini 1.5 Flash analysis, generate a free API key at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google OAuth 2.0 Client ID for Google Sign-In
# - Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# - Create an OAuth 2.0 Client ID for Web Applications with authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# Firebase Admin Project ID for verifying Firebase Google Auth ID tokens
# - Project ID from Firebase Console (e.g. sims-d9539)
FIREBASE_PROJECT_ID=

# SMTP Email Service Configuration (Optional, for real-time 2FA and password reset emails)
# - If unconfigured, verification codes are safely logged to the server terminal console in development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=InternHub Security <security@internhub.edu>

