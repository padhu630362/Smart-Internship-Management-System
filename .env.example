# =====================================================================
# Smart Internship Management System - Root Environment Template
# =====================================================================
# This file provides a centralized overview of all required environment
# variables across both backend/ and frontend/ modules.
# DO NOT store production passwords or secret keys here.
# Copy appropriate variables to backend/.env and frontend/.env respectively.
# =====================================================================

# Backend Configuration (backend/.env)
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/smart_internship_db
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=
JWT_SECRET=replace_with_a_secure_random_secret_in_development_at_least_32_chars
JWT_EXPIRES_IN=7d

# Frontend Configuration (frontend/.env.local)
VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
