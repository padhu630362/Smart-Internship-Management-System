# =====================================================================
# Smart Internship Management System (SIMS) - Frontend Configuration
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env.local for local Vite development:
#    cp .env.example .env.local
# 2. Never commit .env or .env.local to version control (.gitignore excludes them).
# 3. For production hosting (Vercel, Netlify, Cloudflare Pages, AWS S3/CloudFront),
#    configure these environment variables in your platform's dashboard.
# =====================================================================

# Base URL for Express REST API
# - Local Dev: http://localhost:5001/api
# - Production: https://api.sims.yourcollege.edu/api (or /api if using reverse proxy)
VITE_API_URL=http://localhost:5001/api

# WebSocket Server URL for Socket.IO
# - Local Dev: http://localhost:5001
# - Production: https://api.sims.yourcollege.edu
VITE_SOCKET_URL=http://localhost:5001
